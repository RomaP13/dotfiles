# ln -s ~/.cache/wal/mako ~/dotfiles/.config/mako/config
font=IosevkaTerm Nerd Font SemiBold 14
layer=overlay
width=350
height=199
text-alignment=center
default-timeout=10000
border-size=4
border-radius=5
icons=1
max-icon-size=30
ignore-timeout=1
padding=12
icon-location=left
icon-path=/usr/share/icons/Tela-circle-black/
markup=1
actions=1
max-visible=12
history=1

# Pywal dynamic colors
background-color={background}
border-color={color4}
text-color={foreground}

[urgency=low]
background-color={color1}
text-color={background}

[urgency=critical]
background-color={color9}
text-color={foreground}
default-timeout=0
